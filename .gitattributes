# Power BI Desktop writes PBIP text files with Windows line endings
* text=auto eol=crlf

*.tmdl    text eol=crlf
*.json    text eol=crlf
*.pbir    text eol=crlf
*.pbism   text eol=crlf
*.pbip    text eol=crlf
*.dax     text eol=crlf
*.md      text eol=crlf

# Binary Power BI artefacts
*.pbix    binary
*.abf     binary
*.png     binary
*.jpg     binary
