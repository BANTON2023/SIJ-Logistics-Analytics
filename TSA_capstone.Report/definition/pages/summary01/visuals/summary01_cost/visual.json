                  {
                    "value": "Cost: fuel is almost everything",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#14A3A3",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "5pt",
                      "color": "#334155"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "- Cost per load fell 12%",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.5pt",
                      "color": "#0F2A44",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " ($1,272 in 2022 to $1,114 in 2024), mainly because diesel fell from $4.20 to $3.65 a gallon.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.5pt",
                      "color": "#334155"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "- Fuel is 92% of tracked cost,",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.5pt",
                      "color": "#0F2A44",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " and prices differ by only 2 cents between states, so savings must come from using less fuel.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.5pt",
                      "color": "#334155"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "- Margins look high (61%)",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.5pt",
                      "color": "#0F2A44",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " because the data has no driver pay, insurance or overheads.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.5pt",
                      "color": "#334155"
                    }
                  }
